[Unit]
Description=ZeroOps - relay de Producao (consultas de leitura e intervencoes autorizadas do agente)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=zeroops-relay
Group=zeroops-relay
ExecStart=/usr/bin/php -d memory_limit=192M -d display_errors=stderr /opt/zeroops-relay/zeroops-relay.php
Restart=always
RestartSec=5

# Nunca competir com o site: prioridade minima de CPU/IO e limites de recursos.
Nice=19
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
TasksMax=16

# Isolamento: sistema de ficheiros so de leitura, sem privilegios adicionais.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
