# Modelo do ficheiro /etc/zeroops/zeroops.env (chmod 600, dono root). Nunca versionar valores reais.
ZEROOPS_ENVIRONMENT=quality
ZEROOPS_PUBLIC_URL=https://tickets.pizzahut.pt
ZEROOPS_PORT=4311
# Utilizador exclusivo da base `zeroops`; a password vem de /root/.zeroops/zeroops-mysql.cnf.
ZEROOPS_DATABASE_URL=mysql://zeroops:CHANGE_ME@127.0.0.1:3306/zeroops
# 32 bytes em base64: openssl rand -base64 32
ZEROOPS_IDENTITY_KEY=CHANGE_ME
# Acesso descrito no email de convite (passos 1 e 2). Sem DNS publico: IP para a entrada hosts.
# O certificado publico da CA fica em /etc/zeroops/access/ca.crt no host (montado so leitura).
ZEROOPS_ACCESS_HOSTS_IP=192.168.90.79
ZEROOPS_ACCESS_CA_FILE=/etc/zeroops-access/ca.crt

# SMTP opcional; sem estes valores as entregas ficam bloqueadas.
# ZEROOPS_SMTP_HOST=
# ZEROOPS_SMTP_PORT=587
# ZEROOPS_SMTP_FROM=
# ZEROOPS_SMTP_ALLOWED_ENDPOINTS=
# Conectores (BD do site, Loki) e Copilot configuram-se na pagina Integracoes, nao aqui.
# Hosts internos (127.0.0.1, localhost, redes privadas) sao aceites; outros endpoints host:porta
# tem de constar desta allowlist operacional.
# ZEROOPS_CONNECTOR_ALLOWED_ENDPOINTS=
# Timeout opcional de cada investigacao do agente.
# ZEROOPS_AGENT_TIMEOUT_MS=900000
