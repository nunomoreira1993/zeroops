{
  "start": "analise",
  "nodes": [
    {
      "id": "analise",
      "op": "copilot_task",
      "label": "Copilot lê o alerta",
      "config": { "mode": "analysis", "askClient": false }
    },
    {
      "id": "tentativa",
      "op": "copilot_task",
      "label": "Copilot tenta a correção",
      "instructions": "Com base no alerta e na análise, tenta a correção configurada para o projeto. Trabalha numa cópia temporária: não alteres o ambiente. Em summary explica a causa provável, a alteração feita e a evidência que a suporta; em proposedTests indica como verificar a recuperação. Se não for possível corrigir por código ou configuração, explica o que tentaste e o que ficou por confirmar.",
      "config": { "mode": "develop" }
    },
    {
      "id": "correcao",
      "op": "action",
      "label": "Aplicar correção no ambiente",
      "config": { "action": "health_remediation", "procedure": "" }
    },
    {
      "id": "verificar",
      "op": "action",
      "label": "Verificar recuperação",
      "config": { "action": "verify_health_recovery", "timeoutMinutes": 30 }
    },
    {
      "id": "relatorio",
      "op": "copilot_task",
      "label": "Relatório da correção",
      "instructions": "O incidente recuperou. Em summary escreve o relatório técnico para a equipa: o que aconteceu, a correção preparada (diff), se foi aplicada no ambiente e a evidência da recuperação. Em replyDraft escreve só o corpo da mensagem final ao cliente, em português de Portugal, sem detalhes sensíveis.",
      "config": { "mode": "report" }
    },
    {
      "id": "mensagem_cliente",
      "op": "action",
      "label": "Mensagem final ao cliente",
      "config": {
        "action": "client_message",
        "source": "previous_reply",
        "body": "O incidente detetado foi corrigido e o serviço está a funcionar normalmente."
      }
    },
    {
      "id": "relatorio_falha",
      "op": "copilot_task",
      "label": "Registo da tentativa",
      "instructions": "A correção falhou ou não foi possível verificar a recuperação. Em summary regista para a equipa: o que foi tentado, o que ficou por confirmar e o próximo passo recomendado, com as evidências.",
      "config": { "mode": "report" }
    },
    {
      "id": "nota_falha",
      "op": "action",
      "label": "Nota para a equipa",
      "config": {
        "action": "internal_note",
        "source": "previous_summary",
        "body": "A correção automática não ficou verificada. Próximo passo: a equipa analisa o incidente."
      }
    },
    {
      "id": "equipa",
      "op": "human_decision",
      "label": "Decisão da equipa",
      "assignee": { "kind": "team" },
      "config": {
        "options": [
          {
            "port": "resolve",
            "label": "Resolver",
            "requiresComment": true,
            "commentVisibility": "public"
          },
          { "port": "retry", "label": "Tentar de novo", "requiresComment": true },
          { "port": "escalate", "label": "Escalar", "requiresComment": true }
        ]
      }
    },
    { "id": "resolvido", "op": "end", "label": "Resolvido", "config": { "outcome": "resolved" } },
    { "id": "escalado", "op": "end", "label": "Escalado", "config": { "outcome": "escalated" } }
  ],
  "edges": [
