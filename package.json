{
  "name": "zeroops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build --workspace=@zeroops/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@zeroops/web",
    "test": "vitest run && npm run test --workspace=@zeroops/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:metrics": "node scripts/architecture-metrics.mjs",
    "lint": "eslint .",
    "start": "node dist/apps/api/src/main.js",
    "worker": "node dist/apps/worker/src/main.js",
    "migrate": "node dist/packages/backend/src/database/migrate.js",
    "identity:designate-instance-admin": "node dist/apps/api/src/designate-instance-admin.js",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build && npm run format:check",
    "test:browser": "npm run build && tsc -p tsconfig.browser.json && node dist-browser/tests/e2e/browser.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.4.0",
    "otpauth": "^9.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
